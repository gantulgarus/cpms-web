# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production нь НУУЦ БИШ — зөвхөн build-д шаардлагатай нийтийн тугийг
# агуулна. Git-д байлгаснаар байрлуулах бүрд гараар бичих шаардлагагүй.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mock шалгалтын түр гаралт
/.verify-mock
